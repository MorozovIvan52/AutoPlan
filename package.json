{
  "name": "crm-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.prod.ts",
    "setup:prod": "tsx scripts/prod-setup.ts",
    "repair:avito-media": "tsx scripts/repair-avito-media.ts",
    "sync:avito-full": "tsx scripts/sync-avito-full.ts",
    "pitch:investor": "tsx scripts/generate-investor-pitch.ts",
    "pack:upload": "powershell -File scripts/package-for-upload.ps1",
    "pack:client": "powershell -File scripts/package-for-client.ps1",
    "deploy:vps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-to-vps.ps1",
    "backup:setup-yandex": "powershell -File scripts/setup-yandex-backup-vps.ps1",
    "audit:demo": "tsx scripts/pre-demo-audit.ts",
    "audit:prod": "tsx scripts/audit-production.ts",
    "audit:full": "tsx scripts/audit-full.ts",
    "verify:saas": "tsx scripts/verify-saas-env.ts",
    "migrate:postgres": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "verify:postgres": "tsx scripts/verify-postgres-migration.ts",
    "verify:pg-modules": "tsx scripts/verify-pg-modules.ts",
    "fix:ide-sql": "node scripts/verify-ide-sql.mjs",
    "fix:ide-workspace": "node scripts/disable-mssql-workspace.mjs && node scripts/verify-ide-sql.mjs",
    "pg:ensure-modules": "tsx scripts/ensure-pg-modules.ts",
    "fix:demo": "tsx scripts/pre-demo-fix.ts",
    "pilot:seed": "tsx scripts/pilot-demo-polygon.ts",
    "pilot:seed:clean": "tsx scripts/pilot-demo-polygon.ts --clean",
    "pilot:verify": "bash scripts/pilot-demo-verify.sh",
    "agent:context": "bash scripts/agents/collect-context.sh",
    "agent:qa": "bash scripts/agents/trigger-qa-agent.sh",
    "agent:full-audit": "bash scripts/agents/run-full-audit.sh",
    "agent:migration-check": "bash scripts/agents/trigger-migration-check.sh",
    "agent:workflows": "tsx scripts/agents/run-workflow-prompts.ts",
    "agent:cloud-briefing": "node scripts/agents/run-cloud-briefing.cjs",
    "agent:sdk-workflows": "node scripts/agents/run-sdk-workflows.cjs",
    "agent:sync-ai-vps": "node scripts/agents/sync-ai-to-vps.cjs",
    "test:e2e:audit": "playwright test e2e/full-crm-audit.spec.ts --project=chromium",
    "repair:previews": "tsx scripts/repair-conv-previews.ts",
    "vps:run": "powershell -File scripts/run-on-vps.ps1",
    "backup:s3": "bash scripts/ops/backup-to-s3.sh",
    "zzap:check": "tsx scripts/check-price-files.ts",
    "zzap:verify-urls": "tsx scripts/zzap-verify-template-urls.ts",
    "ssh:setup": "python scripts/setup-ssh-access.py",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test api/lib/close-deal-with-payment.test.ts api/lib/password.test.ts api/lib/tenant-limits.test.ts api/lib/tenant-context.test.ts api/middleware/security.test.ts",
    "test": "npm run test:unit",
    "preview": "vite preview --port 4200",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:e2e:billing": "playwright test e2e/billing-saas.spec.ts --project=chromium",
    "test:e2e:sto": "playwright test e2e/sto-workflow.spec.ts --project=chromium",
    "test:e2e:week1": "playwright test e2e/week1-mvp.spec.ts --project=chromium",
    "test:telemetry": "tsx scripts/test-telemetry.ts",
    "e2e:user": "tsx scripts/e2e-user.ts",
    "ai:consult": "tsx scripts/ai-consult.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@sentry/node": "^9.47.0",
    "@sentry/react": "^9.47.0",
    "@tanstack/react-query": "^5.66.0",
    "better-sqlite3": "^12.10.0",
    "csv-parse": "^7.0.1",
    "drizzle-orm": "^0.39.3",
    "fflate": "^0.8.3",
    "hono": "^4.7.4",
    "nanoid": "^5.1.16",
    "pg": "^8.14.1",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.7.0",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.19.2",
    "wouter": "^3.5.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "pdfkit": "^0.19.0",
    "playwright": "^1.61.0",
    "pptxgenjs": "^4.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
