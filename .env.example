# Публичный URL CRM (HTTPS обязателен для Авито/Telegram webhook)
PUBLIC_URL=https://crm.ваш-домен.ru

# Продакшен (обязательно на сервере)
# NODE_ENV=production

# Соль для хеша паролей — уникальная на каждую установку (32+ символов, обязательна для legacy SHA-256)
# AUTH_SALT=замените_на_случайную_строку

# Секрет для CLI: curl -H "X-Install-Key: ..." -X POST /api/seed (обязателен в проде)
# INSTALL_SECRET=

# Токен в URL публичных прайсов ZZap (?t=...). Не задавайте, если в ZZap указана ссылка без ?t=
# ZZAP_PUBLIC_TOKEN=

# Доверять X-Forwarded-For / X-Real-IP (nginx на том же VPS)
# TRUST_PROXY=1
# IP reverse-proxy, которому доверяем (через запятую). По умолчанию 127.0.0.1,::1
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# Число прокси-хопов перед клиентом (обычно 1 для nginx)
# TRUSTED_PROXY_HOPS=1

# WhatsApp App Secret можно задать в UI канала (поле appSecret) или глобально:
# WHATSAPP_APP_SECRET=

# VPS SSH (для scripts/setup-ssh-access.py и npm run deploy:vps)
# VPS_SSH_HOST=159.194.207.50
# VPS_SSH_USER=root
# VPS_SSH_PASSWORD=

# Порт (за nginx обычно 4200)
PORT=4200

# Путь к базе SQLite (для бэкапов укажите отдельную папку)
# CRM_DB_PATH=./data/crm.db

# --- Мониторинг ---
# Токен для /api/metrics (Prometheus / Grafana). Пусто = без авторизации (не рекомендуется в проде)
# METRICS_TOKEN=
# Telegram chat id для алертов React-ошибок (insertBefore и др.)
# CLIENT_ERROR_TELEGRAM_CHAT_ID=

# --- Yandex Object Storage (бэкапы) ---
# Создайте SA в console.yandex.cloud → storage.editor → статический ключ
# YC_S3_ACCESS_KEY_ID=
# YC_S3_SECRET_KEY=
# Затем: npm run backup:setup-yandex
# S3_BUCKET=crmavito-b1g3q7ke-backups
# S3_PREFIX=crmavito/production
# S3_ENDPOINT=https://storage.yandexcloud.net
# AWS_REGION=ru-central1
# BACKUP_RETENTION_DAYS=30

# --- PostgreSQL (миграция с SQLite для SaaS) ---
# DATABASE_URL=postgresql://crm:password@127.0.0.1:5432/crm
# PG_RLS=1
# После push: psql "$DATABASE_URL" -f scripts/setup-postgres-rls.pgsql
# npm run migrate:postgres && npm run verify:postgres

# --- Sentry (мониторинг ошибок) ---
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=crm@1.0.0
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# --- SaaS / мультитенантность (CRM АвтоПлан) ---
# TENANT_BASE_DOMAIN=crmavito.online
# DEFAULT_TENANT_NAME=АвтоПлан
# DEFAULT_TENANT_SLUG=default
# DEFAULT_TENANT_SUBDOMAIN=
# TENANT_REGISTER_SECRET=  # ключ для POST /api/tenants/register (self-service)

# --- SMS (SMS.ru) — напоминания о записи + код акцепта оферты ---
# SMS_API_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ВАЖНО: в проде НЕ ставьте ALLOW_OFFER_OTP_WITHOUT_SMS=1 (обход SMS запрещён для пилота/продаж).
# Для локальной разработки без SMS достаточно не задавать SMS_API_ID (код вернётся в debugCode вне production).

# --- Stripe (биллинг SaaS) — обязательны для online-оплаты ---
# STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx          # обязательно
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx       # обязательно
# STRIPE_PRICE_START=price_xxxxxxxxxxxx          # обязательно для тарифа start
# STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxx
# STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxx
# USD_TO_RUB=100

# --- Лицензиар (договор‑оферта) ---
# LICENSOR_NAME=ООО «АвтоПлан»
# LICENSOR_INN=
# LICENSOR_OGRN=
# LICENSOR_KPP=
# LICENSOR_ADDRESS=
# LICENSOR_BANK=
# LICENSOR_RS=
# LICENSOR_KS=
# LICENSOR_BIK=
# LICENSOR_DIRECTOR=
# LICENSOR_SITE=https://crmavito.online
# PRODUCT_NAME=CRM АвтоПлан
# LICENSE_OFFER_VERSION=2026-07-11
# SUPPORT_TELEGRAM=@your_support
# SUPPORT_PHONE=+7...

# --- 1С / ОФД / онлайн-касса (или Настройки → 1С / Касса) ---
# ONEC_HTTP_URL=https://1c.example.com/hs/crm/export
# ONEC_HTTP_TOKEN=
# OFD_PROVIDER=atol
# OFD_TOKEN=
# OFD_GROUP_CODE=
# CLOUDKASSIR_PUBLIC_ID=
# OFD_WEBHOOK_URL=

# --- Live-проценка поставщиков ---
# ROSSKO_KEY1=
# ROSSKO_KEY2=
# ROSSKO_DELIVERY_ID=000000001
# ROSSKO_ADDRESS_ID=000000001
# EMEX_LOGIN=
# EMEX_PASSWORD=
# EMEX_API_URL=https://ws.emex.ru/EmExService.asmx/GetPrice

# --- Email уведомления (trial, платежи) ---
# SENDGRID_API_KEY=SG.xxxxx
# RESEND_API_KEY=re_xxxxxxxxxxxx
# MAIL_FROM=noreply@ваш-домен.ru
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=xxxxx

# Авито (опционально — можно настроить в UI Настройки → Каналы)
# AVITO_CLIENT_ID=
# AVITO_CLIENT_SECRET=
# AVITO_USER_ID=
# AVITO_WEBHOOK_SECRET=
# Второй аккаунт (slug avito_2):
# AVITO_2_NAME=Авито — ремонт АВД
# AVITO_2_CLIENT_ID=
# AVITO_2_CLIENT_SECRET=
# AVITO_2_USER_ID=
# AVITO_2_WEBHOOK_SECRET=
# Третий аккаунт (slug avito_3):
# AVITO_3_NAME=шлицыРФ
# AVITO_3_CLIENT_ID=
# AVITO_3_CLIENT_SECRET=
# AVITO_3_USER_ID=
# AVITO_3_WEBHOOK_SECRET=
# Четвёртый аккаунт (slug avito_4):
# AVITO_4_NAME=Кватронет52
# AVITO_4_CLIENT_ID=
# AVITO_4_CLIENT_SECRET=
# AVITO_4_USER_ID=
# AVITO_4_WEBHOOK_SECRET=

# Telegram (опционально)
# TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (Meta Business)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_BROADCAST_TEMPLATE=hello_world
# WHATSAPP_BROADCAST_TEMPLATE_LANG=ru

# MAX (российский мессенджер, business.max.ru)
# MAX_BOT_TOKEN=
# MAX_WEBHOOK_SECRET=
# MAX_BOT_NAME=MAX Bot

# YandexGPT / Алиса для операторов (Yandex Cloud → AI Studio → API-ключ)
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=yandexgpt-lite
# Для «Про»: yandexgpt или yandexgpt/latest
#
# OpenAI-compatible LLM (Claude и др.) — приоритетнее Yandex для /api/ai/*
# AI_BASE_URL=https://api.cheat-ai.shop/v1
# AI_API_KEY=
# AI_MODEL=claude-opus-4-8
#
# Yandex Vision OCR (СТС, сканы) — те же YANDEX_API_KEY + YANDEX_FOLDER_ID
# Роль сервисного аккаунта: ai.vision.user (console.yandex.cloud → IAM)
# YANDEX_VISION_ENABLED=true
# YANDEX_VISION_MODEL=page
# OCR_TESSERACT_FALLBACK=true
