{
  "files.associations": {
    "**/*.pgsql": "pgsql",
    "scripts/setup-postgres-rls.sql": "plaintext",
    "SCHEMA_EXTENSIONS.sql": "plaintext",
    "docs/ops/POSTGRES-RLS.md": "markdown",
    "**/scripts/**/*.sql": "plaintext",
    "**/docs/**/*.sql": "pgsql"
  },
  "mssql.intelliSense.enableErrorChecking": false,
  "mssql.intelliSense.enableIntelliSense": false,
  "mssql.autoDisableIntelliSense": true,
  "mssql.connections": [],
  "sqltools.format": {
    "language": "postgresql"
  },
  "sqltools.useNodeRuntime": true,
  "[pgsql]": {
    "editor.defaultFormatter": null
  },
  "[sql]": {
    "editor.defaultFormatter": null
  },
  "[plaintext]": {
    "editor.defaultFormatter": null
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.git/objects/**": true,
    "**/*.db": true,
    "**/*.db-*": true,
    "**/*.wal": true,
    "**/*.shm": true,
    "**/*.traineddata": true,
    "**/*.mp4": true,
    "**/test-results/**": true,
    "**/uploads/**": true,
    "**/logs/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/*.db": true,
    "**/*.traineddata": true,
    "**/test-results": true,
    "**/uploads": true,
    "**/logs": true
  },
  "extensions.ignoreRecommendations": true,
  "files.exclude": {
    "**/*.traineddata": true,
    "**/*.mp4": true,
    "**/crm-upload.zip": true,
    "**/test-results": true
  },
  "python.languageServer": "None"
}
